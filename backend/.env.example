# ========================
# Application
# ========================
APP_NAME=FoodApp
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================
# Database (PostgreSQL)
# ========================
DATABASE_URL=postgresql+asyncpg://foodapp_user:foodapp_pass@localhost:5432/foodapp_db
DATABASE_URL_SYNC=postgresql://foodapp_user:foodapp_pass@localhost:5432/foodapp_db

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# JWT
# ========================
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ========================
# Firebase
# ========================
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_REALTIME_DB_URL=https://your-project-default-rtdb.firebaseio.com

# ========================
# Stripe
# ========================
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ========================
# Google Maps
# ========================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ========================
# DigitalOcean Spaces
# ========================
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=foodapp-storage
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_CDN_ENDPOINT=https://foodapp-storage.nyc3.cdn.digitaloceanspaces.com

# ========================
# Sentry (Monitoring)
# ========================
SENTRY_DSN=

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_PER_MINUTE=60
